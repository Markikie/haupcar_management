generator client {
  provider = "prisma-client-js"
}

datasource haupcar {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Car {
  id                 String   @id @default(uuid())
  registrationNumber String   @unique
  brand              String
  model              String
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("cars")
}
